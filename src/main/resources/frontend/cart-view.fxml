<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="frontend.Cart"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <HBox style="-fx-background-color: #c0392b; -fx-padding: 10 20;">
            <Label text="Dine N Dash"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="15" style="-fx-padding: 30;">
            <Label text="Cart" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <ListView fx:id="cartListView" prefWidth="400" prefHeight="200"/>

            <Label fx:id="totalLabel" text="Total: $0.00" />

            <HBox spacing="10">
                <Button text="Back to Menu" onAction="#onBackToMenuClick"/>
                <Button text="Clear Cart" onAction="#onClearCartClick"/>
                <Button text="Checkout" onAction="#onCheckoutClick"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
