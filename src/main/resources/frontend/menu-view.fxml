<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>


<BorderPane style="-fx-background-color: #f2f2f2;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="frontend.FoodMenuManager">

    <!-- ======= TOP RED HEADER ======= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #c0392b; -fx-padding: 10 20;">
            <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="WEB Name" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- Back button on the right under header in the mockup -->
            <Button onAction="#onBackClick" style="-fx-background-color: white; -fx-text-fill: #c0392b; -fx-font-weight: bold; -fx-background-radius: 5;" text="Back" />
        </HBox>
    </top>

    <!-- ======= CENTER CONTENT ======= -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 30;">

            <!-- Menu title -->
            <HBox alignment="CENTER_RIGHT" prefWidth="600">
                <Label fx:id="menuTitleLabel"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"
                       text="Restaurant Name's Menu" />
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="cartButton"
                        text="Cart"
                        visible="false"
                        onAction="#onCartClick"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 5;"/>
            </HBox>

            <!-- Row of 4 menu items, like your sketch -->
            <HBox alignment="CENTER" spacing="20" fx:id="itemsRow">

                <!-- ITEM 1 -->
				<VBox alignment="CENTER" spacing="5">
				    <Button fx:id="item1ImageBtn"
				            prefHeight="110.0" prefWidth="105.0"
				            style="-fx-background-color: #d0d7e2; -fx-border-color: #bbbbbb;" />
				    <Label fx:id="item1NameLabel" text="Food Name 1"/>
				    <Button style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 5;"
				            text="View more" onAction="#onViewMore" />
				</VBox>
				
				<!-- ITEM 2 -->
				<VBox alignment="CENTER" spacing="5">
				    <Button fx:id="item2ImageBtn"
				            prefHeight="110.0" prefWidth="105.0"
				            style="-fx-background-color: #d0d7e2; -fx-border-color: #bbbbbb;" />
				    <Label fx:id="item2NameLabel" text="Food Name 2"/>
				    <Button style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 5;"
				            text="View more" onAction="#onViewMore" />
				</VBox>
				
				<!-- ITEM 3 -->
				<VBox alignment="CENTER" spacing="5">
				    <Button fx:id="item3ImageBtn"
				            prefHeight="110.0" prefWidth="105.0"
				            style="-fx-background-color: #d0d7e2; -fx-border-color: #bbbbbb;" />
				    <Label fx:id="item3NameLabel" text="Food Name 3"/>
				    <Button style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 5;"
				            text="View more" onAction="#onViewMore" />
				</VBox>
				
				<!-- ITEM 4 -->
				<VBox alignment="CENTER" spacing="5">
				    <Button fx:id="item4ImageBtn"
				            prefHeight="110.0" prefWidth="105.0"
				            style="-fx-background-color: #d0d7e2; -fx-border-color: #bbbbbb;" />
				    <Label fx:id="item4NameLabel" text="Food Name 4"/>
				    <Button style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 5;"
				            text="View more" onAction="#onViewMore" />
				</VBox>

            </HBox>
        </VBox>
    </center>

</BorderPane>
