<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="frontend.SelectResturantType"
            style="-fx-background-color: #f5f5f5;">

    <!-- ================= TOP HEADER ================= -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: #c0392b; -fx-padding: 10 20;">
            <Label text="WEB Name"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- SIGN OUT BUTTON (hidden at first) -->
            <Button fx:id="signOutButton"
                    text="Sign Out"
                    visible="false"
                    style="-fx-background-color: white; -fx-text-fill: #c0392b; -fx-font-weight: bold; -fx-background-radius: 5;"
                    onAction="#onSignOutClick" />

            <!-- SIGN IN / PROFILE BUTTON -->
            <Button fx:id="signInButton"
                    text="Sign In"
                    style="-fx-background-color: white; -fx-text-fill: #c0392b; -fx-font-weight: bold; -fx-background-radius: 5;"
                    onAction="#onSignInClick" />
        </HBox>
    </top>

    <!-- ================= CENTER CONTENT ================= -->
    <center>
        <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 30;">

            <!-- Search bar row -->
            <TextField fx:id="searchField"
                       promptText="Search for restaurants that have your food type"
                       onAction="#onSearchClick"
                       prefWidth="450" />

            <Label text="Craving something right now?"
                   style="-fx-font-size: 16px;" />

            <!-- Food type image buttons -->
            <HBox spacing="25" alignment="CENTER">

                <!-- Buffet -->
                <VBox spacing="5" alignment="CENTER">
                    <Button text="Image"
                            onAction="#onBuffetClick"
                            style="-fx-pref-width: 90; -fx-pref-height: 90;
                                   -fx-background-color: #d0d7e2; -fx-border-color: #bbbbbb;" />
                    <Label text="Buffet" />
                </VBox>

                <!-- Cafe -->
                <VBox spacing="5" alignment="CENTER">
                    <Button text="Image"
                            onAction="#onCafeClick"
                            style="-fx-pref-width: 90; -fx-pref-height: 90;
                                   -fx-background-color: #d0d7e2; -fx-border-color: #bbbbbb;" />
                    <Label text="Cafe" />
                </VBox>

                <!-- Fine Dining -->
                <VBox spacing="5" alignment="CENTER">
                    <Button text="Image"
                            onAction="#onFineDiningClick"
                            style="-fx-pref-width: 90; -fx-pref-height: 90;
                                   -fx-background-color: #d0d7e2; -fx-border-color: #bbbbbb;" />
                    <Label text="Fine Dining" />
                </VBox>

                <!-- Bistro -->
                <VBox spacing="5" alignment="CENTER">
                    <Button text="Image"
                            onAction="#onBistroClick"
                            style="-fx-pref-width: 90; -fx-pref-height: 90;
                                   -fx-background-color: #d0d7e2; -fx-border-color: #bbbbbb;" />
                    <Label text="Bistro" />
                </VBox>

            </HBox>
        </VBox>
    </center>

</BorderPane>
